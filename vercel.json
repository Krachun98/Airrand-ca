{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/projects",
      "destination": "/gallery/",
      "permanent": true
    },
    {
      "source": "/projects/",
      "destination": "/gallery/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/quote/",
      "destination": "/api/quote"
    }
  ]
}
